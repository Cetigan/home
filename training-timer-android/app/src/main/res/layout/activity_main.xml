<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- ================= SETUP PANEL ================= -->
    <ScrollView
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Total training time -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">
                <TextView
                    android:id="@+id/valueTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="40"
                    android:textColor="@color/text_light"
                    android:textSize="48sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="МИН."
                    android:textColor="@color/text_light"
                    android:textSize="30sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Установите время тренировки"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="5"
                android:valueTo="120"
                android:stepSize="5"
                android:value="40" />

            <!-- Work per set -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">
                <TextView
                    android:id="@+id/valueWork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45"
                    android:textColor="@color/text_light"
                    android:textSize="40sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="сек."
                    android:textColor="@color/text_light"
                    android:textSize="26sp" />
            </LinearLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkWork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Длительность подхода (работа)"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderWork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="10"
                android:valueTo="180"
                android:stepSize="5"
                android:value="45" />

            <!-- Rest between sets -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">
                <TextView
                    android:id="@+id/valueRest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75"
                    android:textColor="@color/text_light"
                    android:textSize="40sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="сек."
                    android:textColor="@color/text_light"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Перерыв между подходами"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="10"
                android:valueTo="180"
                android:stepSize="5"
                android:value="75" />

            <!-- Exercise break -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">
                <TextView
                    android:id="@+id/valueExBreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/text_light"
                    android:textSize="40sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/labelExBreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="мин."
                    android:textColor="@color/text_light"
                    android:textSize="26sp" />
            </LinearLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkExerciseBreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Перерыв между упражнениями"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderExBreak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="5"
                android:stepSize="1"
                android:value="2" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/btn_start"
                android:text="Начать тренировку"
                android:textColor="#0B2A5B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:elevation="6dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ================= RUNNING PANEL ================= -->
    <LinearLayout
        android:id="@+id/runPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/phaseLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РАБОТА"
            android:textColor="@color/text_light"
            android:letterSpacing="0.15"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phaseTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="00:45"
            android:textColor="@color/text_light"
            android:textSize="96sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Подход 1"
            android:textColor="@color/text_dim"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/totalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Осталось всего: 40:00"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="40dp"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPauseResume"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_start"
                android:text="Пауза"
                android:textColor="#0B2A5B"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_start"
                android:text="Стоп"
                android:textColor="#B00020"
                android:textStyle="bold"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- Help button -->
    <ImageButton
        android:id="@+id/btnHelp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:src="@android:drawable/ic_menu_help"
        android:contentDescription="Справка" />

</FrameLayout>
